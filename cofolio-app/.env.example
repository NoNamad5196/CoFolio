# Server only. Never prefix new LLM keys with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Vercel server runtime. Existing VITE_SUPABASE_* aliases are also accepted
# server-side; Vite only exposes PUBLIC_* variables to the client bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local SQLite runtime settings:
PORT=4174
HOST=127.0.0.1
DATABASE_PATH=./data/cofolio.sqlite
# Set both behind an HTTPS reverse proxy in a hosted environment.
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true
