{
  "name": "cofolio-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run typecheck && vite build",
    "lint": "eslint src/v2 src/App.tsx src/main.tsx api server scripts tests vite.config.ts",
    "preview": "vite preview",
    "dev:ui": "vite",
    "dev:api": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint:legacy": "eslint src/pages src/context src/components"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.105.4",
    "groq-sdk": "^1.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": "24.x"
  }
}
